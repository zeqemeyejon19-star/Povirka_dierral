<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F3A50"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#00B4D8"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0F1E2D"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#1B2A3B"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#162032"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#0D2D44"/>
        </shape>
    </item>
</selector>
