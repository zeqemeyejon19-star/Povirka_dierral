<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <ScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.45"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textIdNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_id_number"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editIdNumber"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/editIdNumber"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editIdNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:selectAllOnFocus="true"
                    android:inputType="textPostalAddress"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textPaymentAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_payment_account"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editPaymentAccount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/editPaymentAccount"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="@android:color/black"
                    android:id="@+id/textStation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="000"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editPaymentAccount"
                    app:layout_constraintEnd_toStartOf="@+id/editPaymentAccount"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toTopOf="@+id/editPaymentAccount"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editPaymentAccount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="textPostalAddress"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/textStation"
                    app:layout_constraintTop_toBottomOf="@+id/editIdNumber"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textPersonalAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_personal_account"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editPersonalAccount"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/editPersonalAccount"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editPersonalAccount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:selectAllOnFocus="true"
                    android:inputType="textPostalAddress"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editPaymentAccount"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textSeal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_seal_number"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editSeal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/editSeal"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editSeal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editPersonalAccount"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textServiceType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_service_type"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/spinnerServiceType"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/spinnerServiceType"/>
                <Spinner
                    android:textSize="15sp"
                    android:entries="@array/ServiceType_array"
                    android:id="@+id/spinnerServiceType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editSeal"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/client_note"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editNote"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/editNote"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/spinnerServiceType"/>
                <Button
                    android:id="@+id/buttonShowMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/editNote"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textProtocolNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_protocol_number"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editProtocolNumber"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editProtocolNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ems="10"
                    android:inputType="number"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/buttonShowMore"/>
                <ImageButton
                    android:id="@+id/imageButtonQR"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/qr6464"
                    android:scaleType="fitXY"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editProtocolNumber"
                    app:layout_constraintStart_toEndOf="@+id/textProtocolNumber"
                    app:layout_constraintTop_toTopOf="@+id/editProtocolNumber"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_date_time"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editDateTime"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editDateTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="datetime"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editProtocolNumber"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textCounterNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_counter_number"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editCounterNumber"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editCounterNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editDateTime"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textSurname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_surname"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editSurname"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editSurname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editCounterNumber"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textStationCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_city"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutCity"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layoutCity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editSurname">
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"/>
                    <Spinner
                        android:id="@+id/spinnerCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textStreet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_street"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutStreet"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layoutStreet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/layoutCity">
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editStreet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"/>
                    <com.poverka.httpFileClient.searchableSpinner.SearchableSpinner
                        android:id="@+id/spinnerStreet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textBuilding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_building"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutBuilding"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layoutBuilding"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/layoutStreet">
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editBuilding"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_hint_number"
                        android:ems="10"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"
                        android:layout_marginEnd="5dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editBuildingBukva"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_hint_bukva"
                        android:ems="10"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"
                        android:layout_marginEnd="5dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editBuildingKorpus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_hint_korpus"
                        android:ems="10"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textApartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_apartment"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/layoutApartment"
                    app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/layoutApartment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/layoutBuilding">
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editApartment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_hint_number"
                        android:ems="10"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"
                        android:layout_marginEnd="5dp"/>
                    <EditText
                        android:textSize="15sp"
                        android:id="@+id/editApartmentBukva"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="@string/client_hint_bukva"
                        android:ems="10"
                        android:layout_weight="1"
                        android:inputType="textPersonName"
                        android:imeOptions="flagNoFullscreen"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_phone_number"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editPhone"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/client_hint_phone_main"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/layoutApartment"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editPhoneDop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/client_hint_phone_dop"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editPhone"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editPhoneDop2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/client_hint_phone_dop2"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editPhoneDop"/>
                <TextView
                    android:textSize="15sp"
                    android:id="@+id/textEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/client_email"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/editEmail"
                    app:layout_constraintStart_toStartOf="parent"/>
                <EditText
                    android:textSize="15sp"
                    android:id="@+id/editEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/client_hint_email"
                    android:ems="10"
                    android:inputType="textPersonName"
                    android:imeOptions="flagNoFullscreen"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/editPhoneDop2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/buttonRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fill_client"/>
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10sp"
            android:text="@string/image_button_save"
            android:layout_marginStart="20sp"/>
    </LinearLayout>
</LinearLayout>
